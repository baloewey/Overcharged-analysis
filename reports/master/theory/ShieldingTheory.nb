Cell[CellGroupData[{

Cell["5. Ellipses: conformal map", "Section",ExpressionUUID->"cca490d7-c362-4754-96d2-fbb075f0be49"],

Cell["\<\
Ellipse x^2/A^2 + y^2/B^2 < 1, c = Sqrt[A^2 - B^2]. The map w(z) = m^(1/4) \
JacobiSN[(2K(m)/\[Pi]) ArcSin[z/c], m], nome ((A-B)/(A+B))^2, sends it to the \
unit disk. With winding uniform in arclength (eMode 2) the Neumann Green's \
function is G(z,\[Zeta]) = Log|w-\[Omega]| + Log|1 - w \[Omega]\[Conjugate]| \
+ H(z) + H(\[Zeta]), where H is harmonic with \[PartialD]_n H = 2\[Pi]/P - \
|w'(z)| on the wall (a smooth datum, solved by a Fourier series on the disk). \
Energy:\
\>", "Text",ExpressionUUID->"86ff5ff0-eab5-4fc0-a77a-c90a7d60c526"],

Cell["\<\
E/(\[Pi]K) = -\[Sum]_{i<j} 2 q_i q_j (Log|w_i - w_j| + Log|1 - w_i w_j\
\[Conjugate]|) - \[Sum]_i q_i^2 (Log|w'(z_i)| + Log(1 - |w_i|^2)) - 2 Q \
\[Sum]_i q_i H(z_i)\
\>", "Text",ExpressionUUID->"24dfc4e5-b44c-42f1-ad74-6a55b37e6d77"],

Cell[CellGroupData[{

Cell["\<\
setup[A_, B_] := Module[{c, q, m, K, wf, wp, zf, P, nF = 256, al, zs, g, cf},
  c = Sqrt[A^2 - B^2]; q = ((A - B)/(A + B))^2; m = InverseEllipticNomeQ[q]; \
K = EllipticK[m];
  wf = Function[z, m^(1/4) JacobiSN[(2 K/Pi) ArcSin[z/c], m]];
  wp = Function[z, Evaluate[D[m^(1/4) JacobiSN[(2 K/Pi) ArcSin[zz/c], m], zz] \
/. zz -> z]];
  zf = Function[w, c Sin[(Pi/(2 K)) InverseJacobiSN[w/m^(1/4), m]]];
  P = 4 A EllipticE[1 - B^2/A^2];
  al = Table[2 Pi j/nF, {j, 0, nF - 1}]; zs = zf /@ Exp[I al];
  g = (2 Pi/P)/Abs[wp /@ zs] - 1; cf = Fourier[g, FourierParameters -> {-1, \
-1}];
  <|\"A\" -> A, \"B\" -> B, \"w\" -> wf, \"wp\" -> wp, \"z\" -> zf, \"P\" -> P,
    \"H\" -> Function[w, Re[Sum[2 cf[[n + 1]] w^n/n, {n, 1, nF/2 - 1}]]]|>];
energyE[d_, zs_, qs_] := Module[{ws = d[\"w\"] /@ zs, Q = Total[qs], n = \
Length[zs]},
  -Sum[2 qs[[i]] qs[[j]] (Log[Abs[ws[[i]] - ws[[j]]]] + Log[Abs[1 - ws[[i]] \
Conjugate[ws[[j]]]]]), {i, 1, n - 1}, {j, i + 1, n}]
  - Sum[qs[[i]]^2 (Log[Abs[d[\"wp\"][zs[[i]]]]] + Log[1 - Abs[ws[[i]]]^2]), \
{i, n}] - 2 Q Sum[qs[[i]] d[\"H\"][ws[[i]]], {i, n}]];
(* check: the wall maps onto the unit circle *)
With[{d = setup[40., 20.]}, Max[Abs[Abs[d[\"w\"] /@ Table[40 Cos[t] + 20 I \
Sin[t], {t, 0.1, 6.2, 0.5}]] - 1]]]\
\>", "Input",
 CellLabel->
  " In[32]:=",ExpressionUUID->"cdd54f67-252c-4503-8f78-9ccc1aa0340e"],

Cell[OutputFormData["\<\
          -15
1.11022 10\
\>"], "Output",
 CellChangeTimes->{4.000297483009089*^9},
 CellLabel->
  " Out[35]=",ExpressionUUID->"9c2008f1-c411-4de6-be8b-17389e83ec9c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Passive equilibrium of 12 +1/2 (k = 6), area 2500", "Subsection",ExpressionUUID->"add6bd21-1b78-4e2b-8561-285b93309b8d"],

Cell[CellGroupData[{

Cell["\<\
recompute = False;   (* True: relax again (~10 min); False: load relaxed \
positions saved by shielding_ellipse.wl *)
relax[d_, nn_, q_, ph_] := Module[{vars, start, obj, sol},
  vars = Flatten[Table[{u[i], p[i]}, {i, nn}]];
  start = Flatten[Table[{{u[i], 3.0}, {p[i], 2 Pi (i - ph)/nn}}, {i, nn}], \
1];
  obj[v__] := Module[{vv = {v}}, energyE[d, d[\"z\"] /@ Table[Tanh[vv[[2 i - \
1]]]^(1/2) Exp[I vv[[2 i]]], {i, nn}], ConstantArray[q, nn]]];
  sol = FindMinimum[obj @@ vars, start, Method -> \"QuasiNewton\", \
MaxIterations -> 4000];
  {Table[d[\"z\"][Tanh[u[i]]^(1/2) Exp[I p[i]]] /. sol[[2]], {i, nn}], \
sol[[1]]}];
res = Association[Table[eps -> Module[{A = Sqrt[2500. eps/Pi], d},
     d = setup[A, A/eps];
     <|\"d\" -> d, \"zs\" -> If[recompute, First[MinimalBy[{relax[d, 12, 1/2, \
0.5], relax[d, 12, 1/2, 0.]}, Last]][[1]],
         (#[[1]] + I #[[2]]) & /@ Import[\"relaxed_eps\" <> \
ToString[NumberForm[If[eps == 1.0001, 1., eps], {3, 2}]] <> \".csv\"]]|>],
   {eps, {1.0001, 1.2, 1.5, 2.0}}]];
GraphicsRow[Table[With[{d = res[e][\"d\"], zs = res[e][\"zs\"]},
   Graphics[{Circle[{0, 0}, {d[\"A\"], d[\"B\"]}], Red, PointSize[0.03], \
Point[ReIm /@ zs]}, PlotLabel -> \"\[Epsilon] = \" <> ToString[e]]],
  {e, Keys[res]}], ImageSize -> 800]\
\>", "Input",
 CellLabel->
  " In[36]:=",ExpressionUUID->"0fe1dd88-0293-4d5c-a587-427feb4b7142"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{4.000297483263154*^9},
 CellLabel->
  " Out[39]=",ExpressionUUID->"dbc6dc2b-9b3d-4f00-92fc-1da632713047"]
}, Open  ]],

Cell["\<\
The passive layer stays evenly spaced in arclength (gaps at the tips = gaps \
on the flanks), as in the passive simulations; it does not adopt the \
screening (conductor) distribution, which would need gaps \[Epsilon] times \
smaller at the tips.\
\>", "Text",ExpressionUUID->"336541ec-f804-41be-8a34-72035887f474"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Leftover field inside: is the ellipse screened?", "Subsection",ExpressionUUID->"e91199ce-b95e-4923-b79a-53a0cbd6383d"],

Cell[CellGroupData[{

Cell["\<\
layerE[d_, zs_, qs_, z_, qt_] := Module[{w = d[\"w\"][z], ws = d[\"w\"] /@ zs},
  -2 qt Sum[qs[[i]] (Log[Abs[w - ws[[i]]]] + Log[Abs[1 - w \
Conjugate[ws[[i]]]]]), {i, Length[zs]}] - 2 Total[qs] qt d[\"H\"][w]];
Table[Module[{d = res[e][\"d\"], zs = res[e][\"zs\"], A, B, pts, lp},
   A = d[\"A\"]; B = d[\"B\"];
   pts = Select[Flatten[Table[x + I y, {x, -A, A, A/14}, {y, -B, B, B/10}]], \
(Re[#]/A)^2 + (Im[#]/B)^2 < 0.6^2 &];
   lp = layerE[d, zs, ConstantArray[1/2, 12], #, 1/2] & /@ pts;
   {e, Max[lp] - Min[lp]}], {e, Keys[res]}] // TableForm[#, TableHeadings -> \
{None, {\"\[Epsilon]\", \"layer energy range inside the 0.6 level \
(\[Pi]K)\"}}] &\
\>", "Input",
 CellLabel->
  " In[40]:=",ExpressionUUID->"62ab76bd-93a2-4e2e-9981-967d0b6d025b"],

Cell[OutputFormData["\<\
   \[CapitalIDoubleDot]\[Micro]       layer energy range inside the 0.6 level \
(\[CapitalIDoubleDot]\.80K)
   1.0001   0.00356757

   1.2      0.00468719

   1.5      0.0112707

   2.       0.0361644\
\>"], "Output",
 CellChangeTimes->{4.00029748340432*^9},
 CellLabel->
  " Out[41]//TableForm=",ExpressionUUID->"3a4c367b-e148-400b-82ac-\
b320c6b5ffc1"]
}, Open  ]],

Cell["\<\
The range grows ~20\[Times] from the circle to \[Epsilon] = 2 but stays \
\[LessTilde] 0.06 \[Pi]K in the inner 60% (Sec. 6: \[Pi]K \[TildeTilde] 100 \
k_BT, so \[TildeTilde] 6 k_BT): the shielding is imperfect in ellipses but \
modest compared with the approach energies near the wall.\
\>", "Text",ExpressionUUID->"415b0700-d363-4de2-8d09-be14dde6a7cc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Energy scale", "Section",ExpressionUUID->"d800f73e-527b-46c9-8d4d-d0f4fc5c925b"],

Cell["\<\
Measured from equilibrium director fluctuations of passive defect-free \
periodic boxes (runs/Kcalib, frank_constant.py; density 20, mean-field \
potential 10 k_BT): K1 (splay) \[TildeTilde] 42 k_BT, K3 (bend) \[TildeTilde] \
23 k_BT, independent of box size (64^2 and 96^2). One-constant K \
\[TildeTilde] 32 k_BT, \[Pi]K \[TildeTilde] 100 k_BT.\
\>", "Text",ExpressionUUID->"134462ff-355a-4d11-9daa-773e2322ed3f"],

Cell[CellGroupData[{

Cell["\<\
piK = Pi 32.4;   (* k_BT *)
{\"barrier towards a wall -1/2\" -> 0.04 piK, \"pull 4 -> 1 cell (wall / \
free)\" -> {0.30, 0.69} piK,
 \"leftover field inside, eps = 2, inner 60%\" -> 0.059 piK, \"Sqrt[K/zeta] \
(cells), zeta = 0.07\" -> Sqrt[32.4/0.07]}\
\>", "Input",
 CellLabel->
  " In[42]:=",ExpressionUUID->"2fc2a554-0935-4d30-8f88-be57f335d8a5"],

Cell[OutputFormData["\<\
{barrier towards a wall -1/2 -> 4.0715, 
 
>   pull 4 -> 1 cell (wall / free) -> {30.5363, 70.2334}, 
 
>   leftover field inside, eps = 2, inner 60% -> 6.00547, 
 
>   Sqrt[K/zeta] (cells), zeta = 0.07 -> 21.5141}\
\>"], "Output",
 CellChangeTimes->{4.000297483406794*^9},
 CellLabel->
  " Out[43]=",ExpressionUUID->"a7562141-908f-4193-b6f3-2da050eb427c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Limits", "Section",ExpressionUUID->"73464c8f-f4a2-4db3-9af2-3435f522ae9f"],

Cell["\<\
One-constant elasticity (the measured 2D constants differ by a factor ~1.8); \
orientation-dependent interactions ignored; core energies and the cell scale \
enter only through the empirical 0.61-cell offset; no activity or flow. The \
negative-winding ellipses (master document) show that the strong loss of the \
layer with positive winding needs self-propelled wall defects; the elastic \
shielding weakens only modestly with elongation.\
\>", "Text",ExpressionUUID->"3a7d9131-3355-4652-b3f3-72dfd5c0f8fb"]
}, Open  ]]
}, Open  ]]
},
