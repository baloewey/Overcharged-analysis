-1/2}]
 
>     ], {{R0, 31.83, R (cells)}, 15, 64}, 
 
>   {{nW, 14, wall sites 2|k|+2}, 6, 40, 2}]\
\>"], "Output",
 CellChangeTimes->{4.00029748279804*^9},
 CellLabel->
  " Out[31]=",ExpressionUUID->"91f6fa84-d811-4e87-b961-41020e6e5d4a"]
}, Open  ]]
