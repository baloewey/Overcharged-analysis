Cell[CellGroupData[{

Cell["4. A bulk defect approaching the wall layer", "Section",ExpressionUUID->"14acdb88-7c7c-4669-87ee-2492eaefed13"],

Cell["\<\
Mirror circle (k = -6, R = 31.83 = 1.43 \[ScriptL]_a): 2|k|+2 = 14 wall -1/2 \
at the predicted depth plus the 0.61-cell offset. A bulk +1/2 moves along a \
radius towards a wall defect, or towards the gap between two; compared with a \
free -1/2.\
\>", "Text",ExpressionUUID->"8948ae0a-79f0-4c32-8ab3-39ed8add448b"],

Cell[CellGroupData[{

Cell["\<\
approach[R0_, nW_] := Module[{rw = R0 - (0.61 + R0 (1 - ((nW - 1)/(3 nW - \
1))^(1/(2 nW))))},
  {Function[d, Vring[rw - d, 0, nW, rw, R0, 1/2, -1/2] + Vself[rw - d, R0, \
1/2]],
   Function[d, Vring[rw - d, Pi/nW, nW, rw, R0, 1/2, -1/2] + Vself[rw - d, \
R0, 1/2]], rw}];
Vfree[d_] := -2 (1/2) (-1/2) Log[d];
{Vline, Vmid, rw} = approach[31.83, 14];
Grid[{{\"\", \"free -1/2\", \"towards a wall -1/2\"},
  {\"energy released 8 -> 4 cells\", Vfree[8] - Vfree[4], Vline[8] - Vline[4]},
  {\"energy released 4 -> 1 cell\", Vfree[4] - Vfree[1], Vline[4] - \
Vline[1]}}, Frame -> All]\
\>", "Input",
 CellLabel->
  " In[27]:=",ExpressionUUID->"09ce42b5-d2fe-4b4f-b426-ff555b1c00d5"],

Cell[OutputFormData["\<\
                               free -1/2              towards a wall -1/2

                                 1           Log[8]
                               -(-) Log[4] + ------
energy released 8 -> 4 cells     2             2      -0.0349213

                               Log[4]
                               ------
energy released 4 -> 1 cell      2                    0.295481\
\>"], "Output",
 CellChangeTimes->{4.0002974827963057`*^9},
 CellLabel->
  " Out[30]=",ExpressionUUID->"0d348e0f-c6a0-4382-882b-5e030726d93e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Manipulate[Module[{vl, vm, r},
  {vl, vm, r} = approach[R0, nW];
  Plot[{Vfree[d] - Vfree[8], vl[d] - vl[8], vm[d] - vm[8]}, {d, 0.8, 12}, \
Frame -> True, PlotRange -> {-0.8, 0.8},
   FrameLabel -> {\"distance from the wall layer (cells)\", \"energy \
(\[Pi]K), zero at 8\"},
   PlotLegends -> {\"free -1/2\", \"towards a wall -1/2\", \"between two wall \
-1/2\"}]],
 {{R0, 31.83, \"R (cells)\"}, 15, 64}, {{nW, 14, \"wall sites 2|k|+2\"}, 6, \
40, 2}]\
\>", "Input",
 CellLabel->
  " In[31]:=",ExpressionUUID->"fba5b8fe-8fe3-42ca-88bc-bcafc19e80bf"],

Cell[OutputFormData["\<\
Manipulate[Module[{vl, vm, r}, {vl, vm, r} = approach[R0, nW]; 
 
>     Plot[{Vfree[d] - Vfree[8], vl[d] - vl[8], vm[d] - vm[8]}, {d, 0.8, 12}, \

 
>      Frame -> True, PlotRange -> {-0.8, 0.8}, 
 
>      FrameLabel -> 
 
>       {distance from the wall layer (cells), energy (\[CapitalIDoubleDot]\
\.80K), zero at 8}, 
 
