Cell[CellGroupData[{

Cell["Comparison with all passive circles (no free parameter)", "Subsection",ExpressionUUID->"7a4e655e-3c17-4cc6-87ea-ef59e483f3d7"],

Cell["\<\
Data: reports/master/data/passive_circles.tsv (468 passive circles of the \
main sweep; s_mean = mean distance of the imposed defects from the wall). The \
fit gives slope \[TildeTilde] 0.98 and a constant offset of \[TildeTilde] 0.6 \
cells (where the cell-based anchoring puts the effective wall).\
\>", "Text",ExpressionUUID->"af5053f7-9b37-426f-b9a8-d63330c56c58"],

Cell[CellGroupData[{

Cell["\<\
data = Import[FileNameJoin[{projectRoot, \"reports\", \"master\", \"data\", \
\"passive_circles.tsv\"}], \"TSV\"];
rows = Select[Rest[data], #[[2]] <= 0.151 && Abs[#[[3]]] >= 1 &];
pred = (#[[4]] (1 - ((2 Abs[#[[3]]] - 1)/(6 Abs[#[[3]]] - 1))^(1/(4 \
Abs[#[[3]]])))) & /@ rows;
meas = rows[[All, 8]];
fit = LinearModelFit[Transpose[{pred, meas}], x, x];
{Length[rows], fit[\"BestFitParameters\"], Correlation[pred, meas]}\
\>", "Input",
 CellLabel->
  " In[20]:=",ExpressionUUID->"6f307c0c-465f-4e99-8cd4-31aefe282502"],

Cell[OutputFormData["\<\
{310, {0.620995, 0.98437}, 0.995788}\
\>"], "Output",
