}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Show[ListPlot[Transpose[{pred, meas}], Frame -> True, FrameLabel -> \
{\"predicted depth (cells)\", \"measured depth (cells)\"}],
 Plot[{x, fit[x]}, {x, 0, 3.6}, PlotStyle -> {Dashed, Black}]]\
\>", "Input",
