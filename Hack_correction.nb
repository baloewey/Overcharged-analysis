Cell[TextData[{
 "Para arreglar esto, podemos invertir la relaci\[OAcute]n:  para un angulo \
del vector normal dado, caclular el par\[AAcute]metro t, i.e., hay que \
resolver\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"ArcTan", "[", 
     FractionBox[
      RowBox[{"Tan", "[", "t", "]"}], 
      RowBox[{"1", "-", 
       SuperscriptBox["\[Epsilon]", "2"]}]], "]"}], "=", 
    SubscriptBox["\[Theta]", "N"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aabd1178-ce4b-4245-a336-4134f6c44e5b"],
 "\n\ntomando en cuenta que la soluci\[OAcute]n va a estar definida por \
partes para dar cuenta del rango limitado de la arco tangente."
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.977565512287428*^9, 3.9775655759824123`*^9}, {
  3.977565661784403*^9, 3.9775657509642525`*^9}, {3.9775658639842854`*^9, 
  3.9775658909139385`*^9}, {3.9775659213034115`*^9, 3.9775660050081806`*^9}, {
