Notebook[{
Cell[TextData[{
 "Fijaremos la elipse de eccentricidad \[Epsilon] a lo largo del eje x. Su \
ecuaci\[OAcute]n param\[EAcute]trica es\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[Epsilon]", "2"]}]], 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "454314fd-7cf8-e64c-b187-5f6ca1c75a98"],
 ",    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d871b86-2452-474d-ad2c-cf879766e8f7"]
}], "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.977565512287428*^9, 3.9775655759824123`*^9}, {
  3.977565661784403*^9, 3.9775657509642525`*^9}, {3.9775658639842854`*^9, 
  3.9775658909139385`*^9}, {3.9775659213034115`*^9, 
  3.9775659461273193`*^9}},ExpressionUUID->"2c12d20a-adba-6d4e-a194-\
d29da1dcd8ce"],

