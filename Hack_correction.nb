 RowBox[{
  RowBox[{
   RowBox[{"PElipse", "[", 
    RowBox[{"t_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[Epsilon]", "2"]}]], 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", 
     RowBox[{"Sin", "[", "t", "]"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9775660150742455`*^9, 3.9775660544725647`*^9}},
