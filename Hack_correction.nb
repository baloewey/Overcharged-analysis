Cell["Primero calcularemos su vector normal", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.977565512287428*^9, 3.9775655759824123`*^9}, {
  3.977565661784403*^9, 3.9775657509642525`*^9}, {3.9775658639842854`*^9, 
  3.9775658909139385`*^9}, {3.9775659213034115`*^9, 
  3.9775660050081806`*^9}},ExpressionUUID->"6f26c39d-422e-254a-a17f-\
614d8b9b2793"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TElipse", "[", 
    RowBox[{"t_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"PElipse", "[", 
      RowBox[{"t", ",", "\[Epsilon]"}], "]"}], ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TUElipse", "[", 
    RowBox[{"t_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"TElipse", "[", 
     RowBox[{"t", ",", "\[Epsilon]"}], "]"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"TElipse", "[", 
       RowBox[{"t", ",", "\[Epsilon]"}], "]"}], ".", 
      RowBox[{"TElipse", "[", 
       RowBox[{"t", ",", "\[Epsilon]"}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NElipse", "[", 
    RowBox[{"t_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"Refine", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"TUElipse", "[", 
           RowBox[{"t", ",", "\[Epsilon]"}], "]"}], ",", "t"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t", ">", "0"}], ",", 
          RowBox[{"\[Epsilon]", ">", "0"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CurlyEpsilon]", ">", "0"}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "t", "]"}], "!=", "0"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"NElipse", "[", 
  RowBox[{"t", ",", "\[Epsilon]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9775658331720715`*^9, 3.9775658600123672`*^9}, {
  3.977565896105974*^9, 3.9775659294485035`*^9}, {3.977566075300312*^9, 
  3.9775660867885513`*^9}, {3.97756614222896*^9, 3.977566201088623*^9}, {
  3.9775662347412663`*^9, 3.977566399580784*^9}, {3.97756672871179*^9, 
  3.9775667507731133`*^9}, {3.9775668458851967`*^9, 3.9775668501004295`*^9}, {
  3.977567253451048*^9, 3.9775672537835217`*^9}, {3.9775674161142807`*^9, 
  3.977567435027155*^9}, {3.977567530296093*^9, 3.977567582402817*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"a351f13c-c55e-ac48-9c7c-a5bb30e53b05"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{"Cos", "[", "t", "]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Epsilon]", "2"]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Cos", "[", "t", "]"}], "2"], "+", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Sin", "[", "t", "]"}], "2"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "2"]]}], ")"}], 
       RowBox[{"3", "/", "2"}]]}]]}], ",", 
   FractionBox[
    RowBox[{"Sin", "[", "t", "]"}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Cos", "[", "t", "]"}], "2"], "+", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"Sin", "[", "t", "]"}], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "2"]]}], ")"}], 
      RowBox[{"3", "/", "2"}]]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.9775667527916584`*^9, 3.9775668540639095`*^9, 
  3.97756734563818*^9, 3.977567451233412*^9, 3.977567544934332*^9, 
  3.977567586883808*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"e49f2e0b-be3a-b840-b7bb-3a9a680a6e79"]
}, Open  ]],

