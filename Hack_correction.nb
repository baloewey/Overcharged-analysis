                  RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Re", "[", 
                    SubscriptBox["\[Theta]", "N"], "]"}], "\[Equal]", 
                    RowBox[{"-", 
                    FractionBox["\[Pi]", "2"]}]}], "&&", 
                    RowBox[{
                    RowBox[{"Im", "[", 
                    SubscriptBox["\[Theta]", "N"], "]"}], "<", "0"}]}], ")"}],
                     "||", 
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["\[Pi]", "2"]}], "<", 
                    RowBox[{"Re", "[", 
                    SubscriptBox["\[Theta]", "N"], "]"}], "<", 
                    FractionBox["\[Pi]", "2"]}], "||", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Re", "[", 
                    SubscriptBox["\[Theta]", "N"], "]"}], "\[Equal]", 
                    FractionBox["\[Pi]", "2"]}], "&&", 
                    RowBox[{
                    RowBox[{"Im", "[", 
                    SubscriptBox["\[Theta]", "N"], "]"}], ">", "0"}]}], 
                    ")"}]}], ")"}], "&&", 
                RowBox[{
                  TemplateBox[{"1"}, "C"], "\[Element]", 
                  TemplateBox[{}, "Integers"]}]}], Short[#, 7]& ]], 
            Annotation[#, 
             Short[
              And[
               Or[
                And[Re[
                   Subscript[$CellContext`\[Theta], N]] == Rational[-1, 2] Pi,
                  Im[
                   Subscript[$CellContext`\[Theta], N]] < 0], 
                Rational[-1, 2] Pi < Re[
                  Subscript[$CellContext`\[Theta], N]] < Rational[1, 2] Pi, 
                And[Re[
