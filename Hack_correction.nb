Cell[BoxData[{
 RowBox[{
  RowBox[{"FactorVector", "[", "vector_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "commonFactor", "}"}], ",", 
    RowBox[{
     RowBox[{"commonFactor", "=", 
      RowBox[{"PolynomialGCD", "@@", 
       RowBox[{"Flatten", "[", "vector", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"commonFactor", ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{"vector", "/", "commonFactor"}], "]"}]}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Dir", "=", 
  RowBox[{
   RowBox[{"FactorVector", "[", 
    RowBox[{"NElipse", "[", 
     RowBox[{"t", ",", "\[Epsilon]"}], "]"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NUElipse", "[", 
    RowBox[{"t_", ",", "\[Epsilon]_"}], "]"}], "=", 
   RowBox[{"Dir", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Dir", ".", "Dir"}], "]"}]}]}], ";"}]}], "Input",
